# Copy to .env and fill in. NEVER commit the filled-in file.
#   cp .env.example .env
#
# The loader also accepts API_KEYS.env if that is where you keep them.

# --- Phase 1: data layer ---
# Free, instant: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Free tier: https://finnhub.io/register
FINNHUB_API_KEY=

# --- Phase 3: generation (not needed yet) ---
# https://console.anthropic.com
# Set a hard spend limit before first live use (SPEC Appendix D.3).
ANTHROPIC_API_KEY=

# --- Phase 4: audio (not needed yet) ---
# https://platform.openai.com
# Set a hard spend limit before first live use (SPEC Appendix D.3).
OPENAI_API_KEY=

# --- Phase 5: publishing ---
# An unguessable path segment: the feed lives at /f/<FEED_TOKEN>/feed.xml.
# Obscurity, not security. Generate one with:
#   python -c "import os; print(os.urandom(5).hex())"
FEED_TOKEN=

# Your GitHub Pages root, e.g. https://<user>.github.io/<repo>
FEED_BASE_URL=

# Optional presentation overrides
FEED_TITLE=
FEED_AUTHOR=
FEED_DESCRIPTION=
